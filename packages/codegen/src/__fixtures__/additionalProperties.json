{
  "openapi": "3.1.0",
  "info": {
    "title": "additionalProperties next to properties example",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/tags": {
      "get": {
        "operationId": "getTags",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tags"
                }
              }
            }
          }
        }
      }
    },
    "/labels": {
      "get": {
        "operationId": "getLabels",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Labels"
                }
              }
            }
          }
        }
      }
    },
    "/metadata": {
      "get": {
        "operationId": "getMetadata",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metadata"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tags": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          }
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "Labels": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "Metadata": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "extra": {
            "description": "Any JSON value"
          },
          "value": {
            "$ref": "#/components/schemas/AnyValue"
          }
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "AnyValue": {}
    }
  }
}
